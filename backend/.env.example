# SmartShop AI - Environment Variables Configuration

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=SmartShop AI
VERSION=1.0.0
DEBUG=True

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
DATABASE_URL=sqlite:///./smartshop.db
DB_ECHO=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600

# ML Model Configuration
ML_MODELS_PATH=./ml_models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_QUERY_LENGTH=512

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Limits
MAX_SEARCH_RESULTS=50
DEFAULT_SEARCH_LIMIT=10
MAX_COMPARISON_PRODUCTS=5
